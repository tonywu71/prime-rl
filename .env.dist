# Copy to .env (gitignored), fill in, then `sky launch`. The pod mounts .env and
# sources it at runtime. WANDB auth comes from ~/.netrc, not here.

# HF model download (avoids rate limits / gated models).
HF_TOKEN=

# Only needed to install hub envs (`prime env install <owner>/<env>`); the current
# alphabet-sort config uses a workspace env, so this can be left blank.
PRIME_API_KEY=
